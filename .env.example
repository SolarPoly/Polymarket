# ============================================================================
# Copie ce fichier vers .env puis renseigne les valeurs.
#   cp .env.example .env
#
# .env est ignoré par git (cf. .gitignore). NE LE COMMITTE JAMAIS.
# Un dépôt public est indexé par des bots en quelques secondes : une clé
# poussée est une clé perdue, et la supprimer ensuite ne la protège pas.
# Voir SECURITY.md.
# ============================================================================

# --- OBLIGATOIRE -----------------------------------------------------------
# Clé privée du wallet Polygon : 64 caractères hexadécimaux, préfixe 0x optionnel.
# Utilise un wallet dédié au trading, alimenté au strict nécessaire — jamais
# ton wallet principal. Le solde qui s'y trouve est le plafond de ta perte
# en cas de fuite.
POLYGON_PRIVATE_KEY=remplace_par_ta_cle_privee_64_hex

# --- COUPE-CIRCUIT ---------------------------------------------------------
# false (défaut) = lecture seule, aucun ordre ne peut partir.
# Passe à true UNIQUEMENT quand tu veux engager des fonds réels.
POLY_ENABLE_TRADING=false

# --- OPTIONNEL : réseau ----------------------------------------------------
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_CHAIN_ID=137
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
POLY_REQUEST_TIMEOUT=15

# --- OPTIONNEL : credentials L2 du CLOB ------------------------------------
# Dérivables de la clé privée à la demande (`python main.py creds`). Les
# renseigner ici évite un aller-retour réseau à chaque démarrage.
# Les trois vont ensemble : renseigner un seul lève une ConfigError.
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# --- OPTIONNEL : programme builder -----------------------------------------
# Ces credentials sont DÉLIVRÉS PAR POLYMARKET après candidature — ils ne se
# génèrent pas localement. Procédure : docs/BUILDER.md
# Les trois vont ensemble.
BUILDER_API_KEY=
BUILDER_API_SECRET=
BUILDER_API_PASSPHRASE=

# Variante : signeur distant, pour ne pas exposer les creds builder aux
# machines d'exécution. Mutuellement exclusif avec le triplet ci-dessus.
BUILDER_REMOTE_URL=
BUILDER_REMOTE_TOKEN=

# OBSOLÈTE — ne fait rien. Le SDK Polymarket n'accepte pas de « code »
# builder, il exige le triplet ci-dessus. Laisse vide. Voir docs/BUILDER.md.
BUILDER_CODE=
